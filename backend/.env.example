# ========================================
# CES - Cost Estimation System Configuration
# ========================================

# Application Settings
APP_NAME=CES - Cost Estimation System
APP_VERSION=1.0.0
DEBUG=False

# Database Configuration
# Format: postgresql://username:password@host:port/database_name
# Example: postgresql://postgres:password123@localhost:5432/ces
DATABASE_URL=postgresql://username:password@localhost:5432/ces

# ========================================
# SECURITY SETTINGS
# ========================================

# JWT Secret Key - MUST be changed in production!
# Generate a strong random key using: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-change-in-production-use-strong-random-string

# JWT Algorithm (HS256 is standard)
ALGORITHM=HS256

# Access Token Expiration Time (in minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ========================================
# CORS SETTINGS
# ========================================

# CORS Origins - Which frontend domains can access this API
# Use ["*"] to allow ALL origins (for production hosting)
# Use specific origins for development security: ["http://localhost:3000","http://localhost:5173"]
CORS_ORIGINS=["*"]

# ========================================
# MINIO OBJECT STORAGE
# ========================================

# MinIO Server Endpoint
# Format: host:port (e.g., localhost:9000 or your-minio-server.com:9000)
MINIO_ENDPOINT=localhost:9000

# MinIO Access Credentials
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# MinIO Bucket Name (will be auto-created if it doesn't exist)
MINIO_BUCKET=ces-documents

# Use HTTPS for MinIO? (True for production, False for local development)
MINIO_SECURE=False
